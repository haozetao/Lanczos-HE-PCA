  <rect x="80" y="785" width="310" height="125" rx="18" class="card"/>
  <text x="112" y="825" class="body" font-weight="700">线性大块</text>
  <text x="112" y="858" class="small">U·v、Uᵀ·v</text>
  <text x="112" y="882" class="small">replicated secret sharing</text>
  <text x="112" y="906" class="small">非交互、高吞吐</text>

